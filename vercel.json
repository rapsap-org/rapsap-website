    },
    {
      "source": "/contact-us-policy.html",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/v4",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/v4/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/doc-ver",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/doc-ver/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/doc-ver/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/dark-ver",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/dark-ver/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/dark-ver/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/hero-v1",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/hero-v1/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/hero-v1/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/hero-v2",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/hero-v2/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/hero-v2/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/hero-v3",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/hero-v3/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/hero-v3/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
